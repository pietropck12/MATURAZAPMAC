{
  "name": "maturazap-mac",
  "version": "1.0.0",
  "description": "Matura Zap para macOS",
  "main": "src/main.js",
  "author": "Matura Zap",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/license-service.js && node --check src/account-service.js && node --check src/whatsapp.js && node --check src/preload.js && node --check renderer/app.js",
    "icons": "bash scripts/create-icons.sh",
    "dist:mac": "npm run icons && electron-builder --mac dmg zip --x64 --arm64",
    "release:mac": "npm run icons && electron-builder --mac dmg zip --x64 --arm64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^26.0.20"
  },
  "build": {
    "appId": "net.superzapmarketing.maturazap.mac",
    "productName": "Matura Zap",
    "asar": true,
    "asarUnpack": [
      "assets/wppconnect-wa.js"
    ],
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "artifactName": "MaturaZap-Mac-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Matura Zap ${version}",
      "iconSize": 128,
      "contents": [
        { "x": 160, "y": 210 },
        { "x": 440, "y": 210, "type": "link", "path": "/Applications" }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "pietropck12",
      "repo": "MATURAZAPMAC",
      "releaseType": "release"
    }
  }
}

